---
const { starlightRoute } = Astro.locals;
const path = Astro.url.pathname;
const headings = starlightRoute.headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const isWriting = path.startsWith('/writing/');
const section = isWriting ? 'Writing' : starlightRoute.entry.data.title;
const type = isWriting && path !== '/writing/' ? 'Essay' : 'Field note';
const focus = isWriting ? 'AI-assisted delivery' : 'Engineering leadership';
---

<div>
  <p class="rail-label">On this page</p>
  <nav aria-label="Page sections">
    <a href="#_top" class="active">Overview</a>
    {
      headings.map((heading) => (
        <a href={`#${heading.slug}`} class:list={{ nested: heading.depth === 3 }}>
          {heading.text}
        </a>
      ))
    }
  </nav>
</div>

<div class="rail-facts">
  <p class="rail-label">About</p>
  <dl>
    <div>
      <dt>Section</dt>
      <dd>{section}</dd>
    </div>
    <div>
      <dt>Type</dt>
      <dd>{type}</dd>
    </div>
    <div>
      <dt>Focus</dt>
      <dd>{focus}</dd>
    </div>
  </dl>
</div>

<script>
  const railLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.docs-rail nav a'));
  const railTargets = railLinks
    .map((link) => {
      const selector = link.getAttribute('href');
      const target = selector ? document.querySelector<HTMLElement>(selector) : null;

      return target ? { link, target } : null;
    })
    .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => item !== null);

  function updateActiveRailLink(): void {
    const readingLine = window.scrollY + window.innerHeight * 0.28;
    let activeItem = railTargets[0];

    for (const item of railTargets) {
      const targetTop = item.target.getBoundingClientRect().top + window.scrollY;
      if (targetTop > readingLine) break;
      activeItem = item;
    }

    for (const item of railTargets) {
      const active = item === activeItem;
      item.link.classList.toggle('active', active);

      if (active) item.link.setAttribute('aria-current', 'location');
      else item.link.removeAttribute('aria-current');
    }
  }

  updateActiveRailLink();
  window.addEventListener('scroll', updateActiveRailLink, { passive: true });
  window.addEventListener('resize', updateActiveRailLink);
</script>
