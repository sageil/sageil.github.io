---
const { starlightRoute } = Astro.locals;
const path = Astro.url.pathname;
const isEssay = path.startsWith('/writing/') && path !== '/writing/';
const isParallelAgentsEssay = path.includes('ai-agents-working-in-parallel');
const isExtraHeadcountEssay = path.includes('ai-is-not-extra-headcount');

let readingMinutes = 3;

if (isParallelAgentsEssay) {
  readingMinutes = 4;
}

if (isExtraHeadcountEssay) {
  readingMinutes = 8;
}
---

<header class:list={['docs-title', { 'essay-title': isEssay }]}>
  {
    isEssay && (
      <div class="docs-title-meta">
        <div class="reading-progress" data-reading-progress>
          <span>{readingMinutes} min read</span>
          <span class="reading-progress-track" aria-hidden="true"><i /></span>
          <span class="reading-progress-value">0%</span>
        </div>
      </div>
    )
  }
  <h1 id="_top-title">
    {
      isParallelAgentsEssay ? (
        <>The AI agents were<br />working in parallel. I wasn’t.</>
      ) : (
        starlightRoute.entry.data.title
      )
    }
  </h1>
</header>

{
  isEssay && (
    <script>
      const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
      const progressValue = progress?.querySelector<HTMLElement>('.reading-progress-value');
      const article = document.querySelector<HTMLElement>('.main-pane');

      function updateReadingProgress(): void {
        if (!progress || !progressValue || !article) return;

        const articleTop = article.offsetTop;
        const readableDistance = Math.max(article.scrollHeight - window.innerHeight, 1);
        const amountRead = Math.min(Math.max(window.scrollY - articleTop, 0), readableDistance);
        const percentage = Math.round((amountRead / readableDistance) * 100);

        progress.style.setProperty('--reading-progress', `${percentage}%`);
        progressValue.textContent = `${percentage}%`;
      }

      updateReadingProgress();
      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      window.addEventListener('resize', updateReadingProgress);
    </script>
  )
}
