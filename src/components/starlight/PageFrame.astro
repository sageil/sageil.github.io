---
import SiteFooter from '../SiteFooter.astro';

const isEssay = Astro.url.pathname.startsWith('/writing/') && Astro.url.pathname !== '/writing/';
---

<div id="_top" class:list={['field-page', { 'essay-page': isEssay }]}>
  <slot name="header" />
  <div class="site-shell docs-shell">
    <slot name="sidebar" />
    <div class="docs-frame"><slot /></div>
  </div>
  <SiteFooter />
</div>
