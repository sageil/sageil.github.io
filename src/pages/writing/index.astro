---
import Base from '../../layouts/Base.astro';
import EssayList from '../../components/EssayList.astro';
import { getEssays } from '../../lib/writing';

const essays = await getEssays();
---

<Base title="Writing" description="Sammy Ageil on what happens to delivery, code review, metrics and cost when AI writes more of the code.">
  <header class="page-head">
    <h1>Notes</h1>
    <p>I write about what happens to delivery, code review, metrics and cost when AI writes more of the code.</p>
  </header>
  <section class="sec">
    <EssayList essays={essays} />
  </section>
</Base>
